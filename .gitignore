/target
# rust-analyzer's separate check target
/server
# Python tooling for the asset scripts
scripts/.venv/
.cargo
.zed

# perf profiling output
/perf.data
/perf.data.old

# Local flatpak-builder output (the source manifest lives in packaging/flatpak/)
/flatpak-harmonicon/
/target-flatpak/
/.flatpak-builder/
/packaging/flatpak/.flatpak-builder/
/harmonicon.flatpak

# mdbook build output (the source lives in docs/book/src/)
/docs/book/book/

# mdbook build output for the contributor architecture book (the source
# lives in contributing/src/); also its mdbook-plantuml render cache
/contributing/book/
/contributing/.mdbook-plantuml-cache/

# trunk's wasm build output (the source is index.html + Trunk.toml)
/dist/

# Song Editor's dev-only "Debug Recording" checkbox (--features dev):
# raw mic audio + chart copies dumped here for diagnosing pitch-detection
# issues, never meant to be committed.
/assets/debug_songs/


# Gradle build output for the Android APK (the source is
# packaging/android/{settings,build}.gradle.kts + app/). `local.properties`
# holds this machine's SDK path and must never be committed; the build falls
# back to $ANDROID_HOME when it's absent.
/packaging/android/.gradle/
/packaging/android/build/
/packaging/android/app/build/
/packaging/android/local.properties
